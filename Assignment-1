#include <iostream>
using namespace std;

// Merge two sorted arrays
int* mergeArrays(int a[], int n1, int b[], int n2) {
    int* c = new int[n1 + n2];

    int i = 0, j = 0, k = 0;

    // while both arrays have elements
    while (i < n1 && j < n2) {
        if (a[i] > b[j]) {
            c[k++] = b[j++];
        }
        else {
            c[k++] = a[i++];
        }
    }

    // remaining elements of a
    while (i < n1) {
        c[k++] = a[i++];
    }

    // remaining elements of b
    while (j < n2) {
        c[k++] = b[j++];
    }

    return c;
}

// Merge Sort
int* mergeSort(int a[], int n) {

    // if (n == 1) return a
    if (n <= 1) {
        int* result = new int[n];
        if (n == 1)
            result[0] = a[0];
        return result;
    }

    // Divide array into two parts
    int n1 = n / 2;
    int n2 = n - n1;

    int* l1 = new int[n1];
    int* l2 = new int[n2];

    for (int i = 0; i < n1; i++)
        l1[i] = a[i];

    for (int i = 0; i < n2; i++)
        l2[i] = a[n1 + i];

    // l1 = mergeSort(l1)
    l1 = mergeSort(l1, n1);

    // l2 = mergeSort(l2)
    l2 = mergeSort(l2, n2);

    // return merge(l1, l2)
    return mergeArrays(l1, n1, l2, n2);
}

int main() {

    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    int* a = new int[n];

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    int* sortedArray = mergeSort(a, n);

    cout << "Sorted array: ";
    for (int i = 0; i < n; i++) {
        cout << sortedArray[i] << " ";
    }

    cout << endl;

    return 0;
}
